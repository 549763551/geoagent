# ─────────────────────────────────────────────────────────────
# GeoAgent 环境配置示例
# 复制为 .env 后按需修改：  copy .env.example .env   (Windows)
#                          cp   .env.example .env   (macOS/Linux)
# 说明：全部为可选配置。不填 LLM_API_KEY 时，智能体自动运行在
#       离线规则模式，工具调用与产物生成功能完全可用。
# ─────────────────────────────────────────────────────────────

# ---- 大模型（OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180

# ---- 智能体循环控制 ----
# 单次任务允许的最大工具调用步数
AGENT_MAX_STEPS=14
# 逐像元趋势分析的最大像元数，超过则自动抽稀以保证响应速度
TREND_MAX_PIXELS=900000

# ---- 目录（可选，默认使用项目内相对路径）----
# GEO_DATA_ROOT=./raw
# GEO_OUTPUT_DIR=./outputs
# GEO_STATE_DIR=./data
